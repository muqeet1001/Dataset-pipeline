{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Native VStitcher garment catalog",
  "type": "object",
  "required": ["schema_version", "garments"],
  "properties": {
    "schema_version": {"const": 1},
    "garments": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "sex", "file", "sha256", "measurement", "measurement_source", "sizes"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "sex": {"enum": ["male", "female"]},
          "file": {"type": "string", "pattern": "\\.(bw|vsgx)$"},
          "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
          "measurement": {"enum": ["chestcircumference", "waistcircumference", "buttockcircumference"]},
          "measurement_source": {"type": "string", "minLength": 1},
          "sizes": {
            "type": "array",
            "minItems": 3,
            "items": {
              "type": "object",
              "required": ["native_size_id", "name", "circumference_cm"],
              "properties": {
                "native_size_id": {"type": "integer", "minimum": 0},
                "name": {"type": "string", "minLength": 1},
                "circumference_cm": {"type": "number", "exclusiveMinimum": 0}
              }
            }
          }
        }
      }
    }
  }
}
